rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.uid == request.auth.uid;
      allow update: if owns(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if owns(uid);

      match /children/{childId} {
        allow read, write: if owns(uid);
      }

      match /progress/{progressId} {
        allow read, write: if owns(uid);
      }
    }

    match /lessons/{lessonId} {
      allow read: if true;
      // Production lesson authoring should be performed through a trusted
      // server/admin workflow with verified teacher permissions.
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
